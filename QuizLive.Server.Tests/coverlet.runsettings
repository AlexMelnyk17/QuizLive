<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
	<DataCollectionRunSettings>
		<DataCollectors>
			<DataCollector friendlyName="XPlat Code Coverage">
				<Configuration>
					<Format>cobertura</Format>
					<!-- Generated EF migrations and the test project itself say nothing about the app's coverage. -->
					<ExcludeByFile>**/Infrastructure/Data/Migrations/**/*.cs</ExcludeByFile>
					<Exclude>[QuizLive.Server.Tests]*</Exclude>
				</Configuration>
			</DataCollector>
		</DataCollectors>
	</DataCollectionRunSettings>
</RunSettings>
