{
	"trailingComma": "none",
	"tabWidth": 2,
	"useTabs": true,
	"semi": false,
	"singleQuote": true,
	"jsxSingleQuote": true,
	"arrowParens": "avoid",
	"plugins": ["@trivago/prettier-plugin-sort-imports"],
	"importOrder": [
		"<THIRD_PARTY_MODULES>",
		"^@layout/(.*)$",
		"^@theme$",
		"^@theme/(.*)$",
		"^@components/ui$",
		"^@components/ui/(.*)$",
		"^@providers/(.*)$",
		"^@shared/(.*)$",
		"^@modules/(.*)$",
		"^@assets/(.*)$",
		"^@config$",
		"^@config/(.*)$",
		"^@typings/(.*)$",
		"^@utils/(.*)$",
		"^@api/(.*)$",
		"^@src/(.*)$"
	],
	"importOrderSeparation": true,
	"importOrderSortSpecifiers": true
}
